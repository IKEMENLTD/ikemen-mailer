# Dockerfile.render — build IKEMEN MAILER (listmonk fork) from source for Render.
# The stock ./Dockerfile only COPYs a prebuilt binary; Render builds from the repo,
# so this multi-stage file compiles the Go backend + Vue frontend + email-builder,
# packs the static assets into the single binary with stuffbin (`make dist`), and
# ships a small alpine runtime. The entrypoint binds to Render's injected $PORT.

# ---- build stage: Go + Node in one image so `make dist` can run end to end ----
FROM golang:1.26.1-bookworm AS builder

# make/git for the Makefile + version stamping; Node 20 + classic yarn for the frontend.
RUN apt-get update \
    && apt-get install -y --no-install-recommends make git ca-certificates curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g yarn@1.22.22 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

# The stock frontend has a `prebuild` hook that runs eslint before every `yarn build`.
# In a clean container that lint step can exit non-zero (eslint config/plugin
# resolution → exit 2) and abort the whole image build. Linting is a dev/CI concern,
# not a release gate, so drop the hook for the production image only. The repo's
# package.json on disk is untouched — this edits just the copy inside the build stage.
RUN cd frontend && npm pkg delete scripts.prebuild

# `make dist` = build backend (CGO_ENABLED=0) + build frontend + email-builder +
# stuffbin pack. Produces a self-contained ./listmonk with all admin/public assets.
RUN make dist

# ---- runtime stage: minimal alpine, just the packed binary ----
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /listmonk

COPY --from=builder /src/listmonk .
COPY --from=builder /src/config.toml.sample config.toml
COPY render-entrypoint.sh /usr/local/bin/render-entrypoint.sh
RUN chmod +x /usr/local/bin/render-entrypoint.sh

EXPOSE 9000

ENTRYPOINT ["/usr/local/bin/render-entrypoint.sh"]
